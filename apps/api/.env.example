# MetaDesk board API — example environment.
# Copy to .env and adjust. Every variable may also be prefixed with METADESK_.

# Which compute policy the router follows: hybrid | local_only | cloud_only
LLM_MODE=hybrid

# Signing secret for access tokens. Change this before any real deployment.
JWT_SECRET=dev-change-me
# Access token lifetime in minutes.
JWT_EXPIRE_MINUTES=60

# Bootstrap operator created on first startup when the user table is empty.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=changeme

# Your deployed Worker. A paired board also stores it with its device token.
METADESK_CLOUD_URL=https://metadesk-cloud.<your-subdomain>.workers.dev

# A paired board reaches Muse through the Worker gateway and needs no key.
# Set META_API_KEY only to call Meta directly from an unpaired dev board.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Model names used for the cloud tiers.
META_MODEL_FAST=muse-spark-1.3
META_MODEL_HEAVY=muse-wonder-1.0
META_MODEL_ULTRA=muse-wonder-full-1.0

# Billing rates used for cost accounting, in US dollars per 1M tokens.
META_USD_PER_1M_INPUT=4.00
META_USD_PER_1M_OUTPUT=20.00
# Cloud spend ceiling per day, in US dollars. Beyond it the router stays local.
META_DAILY_BUDGET_USD=2.00

# Local Ollama endpoint that serves the on-board model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

# SQLite database used for users, chat and the usage ledger.
DATABASE_URL=sqlite:///./data/metadesk.db

# Sandbox root for the file and shell desk tools.
DESK_ROOT=./workspace

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081
