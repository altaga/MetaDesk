# MetaDesk board agent — example environment.
# Copy to .env and adjust. Every variable may also be prefixed with METADESK_.

# Desk cloud the board dials into (the Worker). The board only ever connects
# outbound; this is the one address it needs.
METADESK_CLOUD_URL=https://metadesk-cloud.<your-subdomain>.workers.dev

# FastAPI board API this agent proxies relayed requests onto.
METADESK_BOARD_URL=http://127.0.0.1:8000

# Label shown for this board in the desk.
METADESK_BOARD_NAME=Jetson

# Where the paired credential is kept. Written 0600 inside this directory.
METADESK_STATE_DIR=~/.config/metadesk

# Must match the board API's JWT_SECRET. The relay only forwards an operator
# identity, so the agent re-signs a short-lived board token with this secret.
# It stays on the board; leave it unset and the repo-root secrets.env wins.
# METADESK_JWT_SECRET=dev-change-me

# Shell the desk terminal opens. Empty means $SHELL, then /bin/bash.
METADESK_TERMINAL_SHELL=

# Lifetime of the board token the agent mints per relayed request.
METADESK_JWT_EXPIRE_MINUTES=60

# Docker board-emu sets this so the desk shows chat-only affordances.
METADESK_BOARD_EMU=false

# Link tuning.
METADESK_HEARTBEAT_SECONDS=25
METADESK_RECONNECT_MAX_SECONDS=30
METADESK_LOG_LEVEL=INFO
