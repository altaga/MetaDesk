# Server-only. The browser never sees these; only the BFF reads them.
# Local: copy this file to .env.local
# Vercel: Project → Settings → Environment Variables (mark them Sensitive).

# Board API. Points at the FastAPI app on the Jetson (or a local dev board).
METADESK_API_URL=http://127.0.0.1:8000

# Optional cloud gateway in front of the boards. Leave empty while the desk
# talks to the board directly; set it once the relay is deployed.
METADESK_CLOUD_URL=

# Apex hostname. When set, app.<host> serves /login and /dashboard and every
# other hostname is rewritten to the landing page. Leave empty on localhost.
METADESK_SITE_HOST=
