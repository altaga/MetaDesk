# MetaDesk — template for the real secrets file.
# Copy to secrets.env (git-ignored) and fill in. Never commit the copy.

# Meta Model API key. Without it the router stays on the local model.
META_API_KEY=

# Your deployed Worker (wrangler deploy prints it). Boards dial out to it.
METADESK_CLOUD_URL=https://metadesk-cloud.<your-subdomain>.workers.dev

# Signing secret for board access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Search keys are cloud-only. Add them when the cloud worker is deployed; the
# board API never reads one.
